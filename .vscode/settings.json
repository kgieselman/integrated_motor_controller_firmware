{
    // ---------------------------------------------------------------------------
    // CMake — disabled in favour of the Dev Container workflow.
    // Configure and build via scripts/build.sh (or the Makefile) inside the
    // container instead of through the VS Code CMake Tools extension.
    // ---------------------------------------------------------------------------
    "cmake.configureOnOpen": false,

    // ---------------------------------------------------------------------------
    // clangd — settings here apply when opening the repo WITHOUT the container.
    // When using "Reopen in Container", devcontainer.json overrides these with
    // the correct paths to the container's /usr/bin/clangd and arm-none-eabi-gcc.
    // ---------------------------------------------------------------------------
    "C_Cpp.intelliSenseEngine": "disabled"
}
