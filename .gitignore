# ============================================================
# chimera-firmware .gitignore
# STM32 C++ / CubeMX / ARM GCC / CMake / STM32CubeIDE / VSCode
# ============================================================


# ------------------------------------------------------------
# Build Artifacts
# ------------------------------------------------------------
build/
Build/
Debug/
Release/
RelWithDebInfo/
MinSizeRel/
out/
*.elf
*.bin
*.hex
*.map
*.lst
*.o
*.a
*.d
*.su          # GCC stack usage files
*.i           # Preprocessed source


# ------------------------------------------------------------
# CMake
# ------------------------------------------------------------
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
_deps/
compile_commands.json   # re-generated by cmake; commit if using clangd
install_manifest.txt


# ------------------------------------------------------------
# STM32CubeMX / STM32CubeIDE
# ------------------------------------------------------------
# CubeIDE project metadata
.project
.cproject
.settings/
.launches/
*.launch

# STM32CubeMX backup files
*.ioc.bak
*.bak


# ------------------------------------------------------------
# IDE / Editor
# ------------------------------------------------------------
# VSCode — keep .vscode/ if the team shares settings,
# but exclude personal/local overrides:
.vscode/ipch/
.vscode/*.code-workspace
.vscode/c_cpp_properties.json   # machine-local include paths
.vscode/launch.json             # debug configs with local paths
.vscode/tasks.json              # optional: commit if shared

# CLion / JetBrains
.idea/
cmake-build-*/

# Eclipse (CubeIDE is Eclipse-based)
.metadata/
RemoteSystemsTempFiles/

# Vim / Emacs swap files
*.swp
*.swo
*~
\#*\#
.\#*


# ------------------------------------------------------------
# Toolchain / Debug / Probe
# ------------------------------------------------------------
# OpenOCD / pyOCD session files
*.cfg.bak
openocd.log

# J-Link log files
JLinkLog.txt
JLinkSettings.ini

# GDB history
.gdb_history


# ------------------------------------------------------------
# Python / Scripts (test harnesses, flash scripts, etc.)
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/


# ------------------------------------------------------------
# macOS
# ------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes


# ------------------------------------------------------------
# Windows
# ------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk


# ------------------------------------------------------------
# Secrets / Credentials (never commit these)
# ------------------------------------------------------------
*.pem
*.key
*.p12
secrets.h
secrets.hpp
credentials.*
