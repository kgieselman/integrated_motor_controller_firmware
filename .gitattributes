# =============================================================
# .gitattributes — IMC Firmware
# Store all text files as LF in the repo. Git handles conversion
# on checkout so Windows tools (CubeMX, editors) still get CRLF
# if core.autocrlf is set, but the repo stays LF-canonical.
# =============================================================

# Default — normalize all text files to LF
* text=auto eol=lf

# Windows batch files must stay CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files — never touch line endings
*.elf binary
*.bin binary
*.hex binary
*.o   binary
*.a   binary
*.png binary
*.jpg binary
*.pdf binary

# STM32CubeMX project file
*.ioc text eol=lf

# Linker scripts
*.ld  text eol=lf

# =============================================================
# GitHub Linguist — keep language stats focused on app code,
# not the vendor HAL/CMSIS files.
# =============================================================
cubemx/Drivers/** linguist-vendored
cubemx/Core/Src/syscalls.c linguist-vendored
cubemx/Core/Src/sysmem.c   linguist-vendored
